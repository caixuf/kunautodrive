#!/usr/bin/env bash
# ==============================================================================
# kunctl — KunQuant 生产级系统服务管理与诊断工具
#
# 用法:
#   kunctl start        后台启动 KunQuant 原生 C++ 守护进程服务
#   kunctl stop         优雅停止守护进程
#   kunctl restart      重启服务
#   kunctl status       查看服务进程状态、PID、内存、端口及资源占用
#   kunctl logs [-f]    查看/追踪服务运行日志
#   kunctl install      将服务注册为 systemd 系统级服务 (开机自启)
#   kunctl uninstall    从 systemd 注销服务
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

PID_FILE="/tmp/kunquant.pid"
LOG_FILE="/tmp/kunquant.log"
BIN_PATH="${ROOT_DIR}/build/bin/kun_quant_server"
PORT=8900
STATIC_DIR="${ROOT_DIR}/tools/kunboard"

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

check_running() {
    if [[ -f "${PID_FILE}" ]]; then
        local pid
        pid=$(cat "${PID_FILE}")
        if kill -0 "${pid}" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

cmd_start() {
    if check_running; then
        local pid
        pid=$(cat "${PID_FILE}")
        echo -e "${YELLOW}[KunQuant] 服务已在运行中 (PID: ${pid}, Port: ${PORT})${NC}"
        return 0
    fi

    if [[ ! -x "${BIN_PATH}" ]]; then
        echo -e "${YELLOW}[KunQuant] 正在编译原生 C++ 服务端...${NC}"
        cmake --build "${ROOT_DIR}/build" --target kun_quant_server -j4
    fi

    echo -e "${CYAN}[KunQuant] 正在以系统级守护进程启动...${NC}"
    cd "${ROOT_DIR}"
    setsid "${BIN_PATH}" --port "${PORT}" --static-dir "${STATIC_DIR}" >> "${LOG_FILE}" 2>&1 &
    local new_pid=$!
    echo "${new_pid}" > "${PID_FILE}"

    sleep 0.8
    if kill -0 "${new_pid}" 2>/dev/null; then
        echo -e "${GREEN}[KunQuant] 服务启动成功!${NC}"
        echo -e "  PID         : ${new_pid}"
        echo -e "  Dashboard   : ${BLUE}http://localhost:${PORT}${NC}"
        echo -e "  Log File    : ${LOG_FILE}"
    else
        echo -e "${RED}[KunQuant] 服务启动失败，请检查日志: ${LOG_FILE}${NC}"
        exit 1
    fi
}

cmd_stop() {
    if ! check_running; then
        echo -e "${YELLOW}[KunQuant] 服务未在运行。${NC}"
        rm -f "${PID_FILE}"
        return 0
    fi

    local pid
    pid=$(cat "${PID_FILE}")
    echo -e "${CYAN}[KunQuant] 正在向 PID ${pid} 发送优雅停机信号 (SIGTERM)...${NC}"
    kill -15 "${pid}" 2>/dev/null || true

    for i in {1..30}; do
        if ! kill -0 "${pid}" 2>/dev/null; then
            echo -e "${GREEN}[KunQuant] 服务已安全停止。${NC}"
            rm -f "${PID_FILE}"
            return 0
        fi
        sleep 0.1
    done

    echo -e "${RED}[KunQuant] 进程未在规定时间内退出，强制终止 (SIGKILL)...${NC}"
    kill -9 "${pid}" 2>/dev/null || true
    rm -f "${PID_FILE}"
}

cmd_restart() {
    cmd_stop
    sleep 0.5
    cmd_start
}

cmd_status() {
    echo -e "\n======================================================="
    echo -e "          KunQuant 生产级服务状态监控                 "
    echo -e "======================================================="
    if check_running; then
        local pid
        pid=$(cat "${PID_FILE}")
        echo -e "  运行状态    : ${GREEN}● RUNNING (在线)${NC}"
        echo -e "  主进程 PID  : ${pid}"
        echo -e "  服务端口    : ${PORT}"
        echo -e "  Web 工作台  : ${BLUE}http://localhost:${PORT}${NC}"
        
        # 获取内存与 CPU 信息
        if command -v ps &>/dev/null; then
            local ps_info
            ps_info=$(ps -p "${pid}" -o %cpu,%mem,vsz,rss,etime --no-headers 2>/dev/null || true)
            if [[ -n "${ps_info}" ]]; then
                echo -e "  资源占用    : CPU/MEM/VSZ/RSS/ETIME: ${ps_info}"
            fi
        fi
    else
        echo -e "  运行状态    : ${RED}○ STOPPED (未运行)${NC}"
    fi
    echo -e "=======================================================\n"
}

cmd_logs() {
    if [[ ! -f "${LOG_FILE}" ]]; then
        echo -e "${YELLOW}[KunQuant] 暂无日志文件: ${LOG_FILE}${NC}"
        return 0
    fi

    if [[ "${1:-}" == "-f" ]]; then
        tail -f "${LOG_FILE}"
    else
        tail -n 50 "${LOG_FILE}"
    fi
}

cmd_install_systemd() {
    local service_src="${ROOT_DIR}/systemd/kunquant.service"
    local service_dest="/etc/systemd/system/kunquant.service"

    echo -e "${CYAN}[KunQuant] 正在注册为 systemd 系统级服务...${NC}"
    if [[ $EUID -ne 0 ]]; then
        echo -e "${YELLOW}需要 sudo 权限将服务文件复制到 /etc/systemd/system/${NC}"
        sudo cp "${service_src}" "${service_dest}"
        sudo systemctl daemon-reload
        sudo systemctl enable kunquant.service
    else
        cp "${service_src}" "${service_dest}"
        systemctl daemon-reload
        systemctl enable kunquant.service
    fi

    echo -e "${GREEN}[KunQuant] systemd 服务安装成功! 可以使用以下命令管理:${NC}"
    echo "  sudo systemctl start kunquant"
    echo "  sudo systemctl status kunquant"
    echo "  sudo systemctl stop kunquant"
}

case "${1:-}" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    logs)
        cmd_logs "${2:-}"
        ;;
    install)
        cmd_install_systemd
        ;;
    *)
        echo "用法: kunctl {start|stop|restart|status|logs [-f]|install}"
        exit 1
        ;;
esac
