{
  "log_file": "launcher.log",
  "log_level": 2,
  "monitor_interval": 5,
  "enable_monitor": true,
  "_comment_allow_hung_subs": "发布者存在性 gate (ci/gates/topic_contract_check.py) 允许此列表中的订阅无发布者：sensor/pose — 默认 profile 无 slam_node；GPS-only 时 fusion 走 GPS 路径",
  "_comment_variant": "[sensor 变体：sensor_model 真点云(lidar_mode=1) + perception 真感知(mode=sensor)，用于观测模型标定/感知指标度量；默认编排见 pipeline.json]",
  "allow_hung_subs": [
    "sensor/pose"
  ],
  "scheduler": {
    "mode": "choreo",
    "worker_threads": 0,
    "tick_us": 1000
  },
  "processes": [
    {
      "name": "flowsim",
      "library_path": "build/lib/libflowsim_node.so",
      "auto_start": true,
      "subscribe": [
        "control/cmd"
      ],
      "publish": [
        {
          "topic": "vehicle/state",
          "type": "VehicleState",
          "qos": {
            "depth": 1,
            "policy": "drop_oldest",
            "reliability": "best_effort",
            "deadline_ms": 50
          }
        },
        {
          "topic": "road/geometry",
          "type": "RoadGeometry",
          "qos": {
            "depth": 1,
            "policy": "drop_oldest",
            "reliability": "best_effort"
          }
        },
        {
          "topic": "road/traffic_lights",
          "qos": {
            "depth": 1,
            "policy": "drop_oldest",
            "reliability": "best_effort"
          }
        },
        {
          "topic": "road/ref_path"
        },
        {
          "topic": "sim/tick",
          "qos": {
            "depth": 1,
            "policy": "drop_oldest",
            "reliability": "best_effort"
          }
        },
        {
          "topic": "sim/collision",
          "qos": {
            "depth": 4,
            "policy": "drop_oldest",
            "reliability": "best_effort"
          }
        },
        {
          "topic": "scene/frame",
          "qos": {
            "depth": 1,
            "policy": "drop_oldest",
            "reliability": "best_effort"
          }
        },
        {
          "topic": "environment/state"
        }
      ],
      "params": "{\"init_speed\": 5.0, \"target_speed\": 20.0, \"random_seed\": 42, \"scenario_file\": \"scenarios/straight_road.json\", \"physics_model\": \"kinematic\"}"
    },
    {
      "name": "sensor_model",
      "library_path": "build/lib/libsensor_model.so",
      "auto_start": true,
      "subscribe": [
        "vehicle/state",
        "environment/state"
      ],
      "publish": [
        {
          "topic": "sensor/lidar",
          "type": "LidarFrame",
          "qos": {
            "depth": 2,
            "policy": "drop_oldest",
            "reliability": "best_effort",
            "deadline_ms": 50
          }
        },
        {
          "topic": "sensor/lidar_points",
          "type": "LidarPointCloud",
          "qos": {
            "depth": 2,
            "policy": "drop_oldest",
            "reliability": "best_effort",
            "deadline_ms": 50
          }
        },
        {
          "topic": "sensor/gps",
          "type": "GpsFrame",
          "qos": {
            "depth": 1,
            "policy": "drop_oldest",
            "reliability": "best_effort",
            "deadline_ms": 100
          }
        },
        {
          "topic": "sensor/camera",
          "type": "CameraFrame",
          "qos": {
            "depth": 1,
            "policy": "drop_oldest",
            "reliability": "best_effort"
          }
        }
      ],
      "params": "{\"lidar_rate_hz\": 20, \"lidar_fov_deg\": 120.0, \"lidar_max_range_m\": 120.0, \"obs_noise_std_m\": 0.08, \"enable_simple_occlusion\": 1, \"lidar_mode\": 1, \"lidar_azimuth_rays\": 720, \"lidar_channels\": 32, \"lidar_vfov_min_deg\": -20.0, \"lidar_vfov_max_deg\": 2.0, \"lidar_height_m\": 1.8, \"lidar_noise_rel\": 0.002}"
    },
    {
      "name": "perception",
      "library_path": "build/lib/libperception_node.so",
      "auto_start": true,
      "subscribe": [
        "vehicle/state",
        "sensor/lidar",
        "sensor/lidar_points",
        "road/geometry"
      ],
      "publish": [
        {
          "topic": "perception/obstacles",
          "type": "ObstacleList"
        }
      ],
      "params": "{\"frequency_hz\": 10.0, \"mode\": \"sensor\", \"lidar_max_range_m\": 120.0, \"dbscan_eps\": 1.2, \"dbscan_min_pts\": 4}"
    },
    {
      "name": "object_tracker",
      "library_path": "build/lib/libobject_tracker_node.so",
      "auto_start": true,
      "subscribe": [
        "perception/obstacles",
        "vehicle/state"
      ],
      "publish": [
        {
          "topic": "perception/tracked_objects",
          "type": "TrackedObjectList"
        }
      ],
      "params": "{\"rate_hz\":20.0}"
    },
    {
      "name": "fusion",
      "library_path": "build/lib/libfusion_node.so",
      "auto_start": true,
      "subscribe": [
        "sensor/lidar",
        "sensor/gps",
        "sensor/pose"
      ],
      "publish": [
        {
          "topic": "fusion/localization",
          "type": "Localization",
          "qos": {
            "depth": 8,
            "policy": "drop_oldest",
            "reliability": "best_effort",
            "deadline_ms": 50
          }
        },
        {
          "topic": "fusion/latency",
          "type": "LatencyReport"
        }
      ],
      "params": "{\"frequency_hz\":20.0}"
    },
    {
      "name": "behavior_planner",
      "library_path": "build/lib/libbehavior_planner_node.so",
      "auto_start": true,
      "subscribe": [
        "fusion/localization",
        "perception/tracked_objects",
        "perception/obstacles",
        "vehicle/state",
        "road/geometry",
        "road/traffic_lights",
        "road/ref_path",
        "scene/frame"
      ],
      "publish": [
        {
          "topic": "planning/behavior",
          "type": "Behavior",
          "qos": {
            "depth": 1,
            "policy": "drop_oldest",
            "reliability": "best_effort",
            "deadline_ms": 50
          }
        }
      ],
      "params": "{\"target_speed\":20.0}"
    },
    {
      "name": "navigation",
      "library_path": "build/lib/libnavigation_node.so",
      "auto_start": true,
      "subscribe": [
        "fusion/localization",
        "road/ref_path"
      ],
      "publish": [
        {
          "topic": "navigation/path",
          "qos": {
            "depth": 1,
            "policy": "drop_oldest",
            "reliability": "best_effort",
            "deadline_ms": 100
          }
        }
      ],
      "params": "{\"rate_hz\": 10.0, \"scenario_file\": \"scenarios/straight_road.json\"}"
    },
    {
      "name": "planning",
      "library_path": "build/lib/libplanning_node.so",
      "auto_start": true,
      "subscribe": [
        "fusion/localization",
        "perception/obstacles",
        "road/geometry",
        "road/ref_path",
        "road/traffic_lights",
        "environment/state",
        "scene/frame",
        "planning/behavior",
        "navigation/path"
      ],
      "publish": [
        {
          "topic": "planning/trajectory",
          "type": "Trajectory",
          "qos": {
            "depth": 1
          }
        }
      ],
      "params": "{\"target_speed\": 20.0, \"max_speed\": 20.0, \"max_accel\": 4.0, \"ref_path_length_m\": 5000.0, \"highway_speed_mps\": 10.0, \"scenario_file\": \"scenarios/straight_road.json\"}"
    },
    {
      "name": "control",
      "library_path": "build/lib/libcontrol_node.so",
      "auto_start": true,
      "subscribe": [
        "fusion/localization",
        "planning/trajectory",
        "planning/behavior"
      ],
      "publish": [
        {
          "topic": "control/raw_cmd",
          "type": "ControlRaw",
          "qos": {
            "depth": 8,
            "policy": "drop_oldest",
            "reliability": "best_effort",
            "deadline_ms": 100
          }
        }
      ],
      "params": "{\"pid_kp\": 800.0, \"pid_ki\": 50.0, \"pid_kd\": 100.0, \"target_speed\": 20.0, \"lat_kp\": 0.6, \"lat_kd_heading\": 1.5, \"yaw_damping\": 0.35, \"k_v_lat\": 0.22, \"k_vy\": 0.4, \"k_vy_damp\": 0.4, \"mpc_horizon\": 0, \"scenario_file\": \"scenarios/straight_road.json\"}"
    },
    {
      "name": "safety_control",
      "library_path": "build/lib/libsafety_control_node.so",
      "auto_start": true,
      "subscribe": [
        "control/raw_cmd",
        "fusion/localization",
        "perception/obstacles"
      ],
      "publish": [
        {
          "topic": "control/cmd",
          "type": "ControlCmd",
          "qos": {
            "depth": 8,
            "policy": "drop_oldest",
            "reliability": "best_effort",
            "deadline_ms": 50
          }
        },
        {
          "topic": "safety/evidence"
        }
      ],
      "params": "{\"max_throttle\":1.0,\"max_steer\":0.22,\"low_speed_steer\":0.18,\"time_headway\":1.3}"
    },
    {
      "name": "inference",
      "library_path": "build/lib/libinference_node.so",
      "auto_start": true,
      "subscribe": [
        "fusion/localization",
        "planning/trajectory",
        "perception/obstacles",
        "control/cmd",
        "model_ota/active",
        "road/traffic_lights",
        "road/geometry"
      ],
      "publish": [
        {
          "topic": "inference/trajectory",
          "type": "Trajectory",
          "qos": {
            "depth": 1,
            "policy": "drop_oldest",
            "reliability": "best_effort"
          }
        },
        {
          "topic": "inference/assist"
        },
        {
          "topic": "inference/raw_cmd"
        }
      ],
      "params": "{\"max_speed\":20.0,\"frequency_hz\":20.0,\"backend\":\"cortex\",\"control_mode\":\"shadow\"}"
    },
    {
      "name": "bev_detection",
      "library_path": "build/lib/libbev_detection_node.so",
      "auto_start": true,
      "subscribe": [
        "vehicle/state",
        "road/geometry",
        "model_ota/active"
      ],
      "publish": [
        {
          "topic": "bev/obstacles",
          "qos": {
            "depth": 1,
            "policy": "drop_oldest",
            "reliability": "best_effort"
          }
        }
      ],
      "params": "{\"frequency_hz\":10.0,\"enable\":true,\"model_path\":\"\"}"
    },
    {
      "name": "data_recorder",
      "library_path": "build/lib/libdata_recorder_node.so",
      "auto_start": true,
      "subscribe": [
        "fusion/localization",
        "planning/trajectory",
        "perception/obstacles",
        "control/cmd",
        "road/traffic_lights",
        "road/geometry"
      ],
      "params": "{\"frequency_hz\":20.0,\"output_path\":\"/tmp/flow_train_samples.jsonl\"}"
    },
    {
      "name": "learner",
      "library_path": "build/lib/liblearner_node.so",
      "auto_start": true,
      "subscribe": [
        "fusion/localization",
        "planning/trajectory",
        "perception/obstacles",
        "control/cmd"
      ],
      "publish": [
        {
          "topic": "learner/status",
          "qos": {
            "depth": 1,
            "policy": "drop_oldest",
            "reliability": "best_effort"
          }
        }
      ],
      "params": "{\"train_hz\":0.5,\"lr\":0.001,\"batch_size\":32,\"buffer_size\":512,\"full_finetune\":0,\"save_interval\":50,\"model_path\":\"tools/train/model.txt\",\"save_path\":\"/tmp/flow_learner_model.txt\"}"
    },
    {
      "name": "model_ota",
      "library_path": "build/lib/libmodel_ota_node.so",
      "auto_start": true,
      "subscribe": [
        "model_ota/cmd",
        "fusion/localization"
      ],
      "publish": [
        {
          "topic": "model_ota/active",
          "qos": {
            "depth": 1,
            "policy": "drop_oldest",
            "reliability": "best_effort"
          }
        },
        {
          "topic": "model_ota/status",
          "qos": {
            "depth": 1,
            "policy": "drop_oldest",
            "reliability": "best_effort"
          }
        },
        {
          "topic": "model_ota/ab_result",
          "qos": {
            "depth": 1,
            "policy": "drop_oldest",
            "reliability": "best_effort"
          }
        }
      ],
      "params": "{\"poll_interval_ms\":500,\"status_hz\":1.0,\"ab_ratio\":0.5,\"runtime_model_path\":\"tools/train/model.txt\",\"registry_path\":\"models/registry.json\"}"
    },
    {
      "name": "monitor",
      "library_path": "build/lib/libmonitor_node.so",
      "auto_start": true,
      "subscribe": [
        "perception/obstacles",
        "vehicle/state",
        "fusion/latency",
        "flowengine/node_info",
        "planning/trajectory",
        "road/geometry",
        "scene/frame",
        "control/cte",
        "road/traffic_lights",
        "safety/evidence"
      ],
      "params": "{\"state_file\":\"/tmp/flow_topology.json\",\"export_scene\":true}",
      "publish": [
        {
          "topic": "pem/degrade_event"
        }
      ]
    }
  ],
  "profile": "default",
  "_governance": "topic-contract: subscribe/publish must match NodePlugin s_inputs/s_outputs (tools/topic_contract_check.py)"
}
