{
  "id": "rc-car",
  "status": "ready",
  "base_pipeline": "pipeline_car.json",
  "platform": "linux-arm64",
  "variant": "l2-waypoint-pca9685",
  "nodes": {
    "gps_driver": {
      "params": {"serial_port": "/dev/ttyUSB0", "baud_rate": 9600}
    },
    "imu_driver": {
      "params": {"serial_port": "/dev/ttyUSB2", "baud_rate": 115200}
    },
    "lidar_driver": {
      "params": {"serial_port": "/dev/ttyUSB1"}
    },
    "waypoint_follower": {
      "params": {
        "waypoints_file": "${PRODUCT_HOME}/etc/waypoints.json",
        "cruise_speed": 2.0
      }
    },
    "actuator": {
      "library_path": "build/lib/libactuator_pwm_node.so",
      "params": {
        "backend": "pca9685",
        "i2c_bus": 1,
        "i2c_addr": 64,
        "esc_channel": 0,
        "steer_channel": 1
      }
    },
    "monitor": {
      "params": {"mode": "production", "frequency_hz": 1.0}
    }
  }
}
